{
  "name": "habit-compass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android:local": "tsc -b && vite build --mode mobile && cap sync android",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:supabase:functions": "pnpm exec supabase start && pnpm exec supabase migration up --include-all && vitest run --config vitest.supabase.config.ts",
    "test:watch": "vitest",
    "test:a11y": "playwright test src/test/e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/app": "7.0.0",
    "@capacitor/core": "7.4.3",
    "@dnd-kit/react": "^0.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "@revenuecat/purchases-capacitor-ui": "^11.3.2",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "headroom-ai": "^0.22.4",
    "lucide-react": "^0.545.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-intl": "^7.1.11",
    "recharts": "^3.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "7.4.3",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
